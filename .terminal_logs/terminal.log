  shadowMd: "0 1px 3px rgba(16,24,40,0.08), 0 1px 2px rgba(16,24,40,0.04)",
};

const AVATAR_COLORS = ["#4F46E5", "#0284C7", "#0F9D58", "#B45309", "#DB2777", "#7C3AED", "#0891B2", "#65A30D"];

const FONT_MONO =
